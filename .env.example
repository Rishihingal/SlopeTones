# From tone3000.com -> Settings -> API Keys -> Create API Key (starts with t3k_pub_)
VITE_T3K_PUBLISHABLE_KEY=t3k_pub_your_key_here

# Must be registered as an allowed redirect URI on your TONE3000 API key.
# Localhost origins are allowed automatically during development.
VITE_T3K_REDIRECT_URI=http://localhost:5173
